# ===========================================================================
# LIVE DEPLOYMENT REFERENCE (ambrosianuk.com) — commented out on purpose.
# Production does NOT use this file; it uses .env.prod with docker-compose.vps.yml.
# Kept here only as a record of the live values. Uncomment NOTHING for local dev.
#
#   API_DOMAIN=api.ambrosianuk.com        # backend  (served by host nginx)
#   APP_DOMAIN=chat.ambrosianuk.com       # dashboard (served by host nginx)
#   DATABASE_URL=postgresql+psycopg2://rag:<pw>@postgres:5432/rag
#   QDRANT_URL=http://qdrant:6333
#   OLLAMA_URL=http://ollama:11434
#   CORS_ORIGINS=https://chat.ambrosianuk.com
#   ADMIN_TOKEN=<openssl rand -hex 32>    # real value only in server .env.prod
#   JWT_SECRET=<openssl rand -hex 32>     # real value only in server .env.prod
# ===========================================================================

# ── LLM ──────────────────────────────────────────────────────────────────
# Provider behind a small abstraction (app/services/llm.py). Today: "ollama".
LLM_PROVIDER=ollama
# Inside docker-compose this is overridden to http://ollama:11434
OLLAMA_URL=http://localhost:11434
# Default model for new chatbots; each chatbot can override its own model.
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.2
# Small context window — tuned for a 3B model on CPU.
LLM_NUM_CTX=4096
LLM_TIMEOUT=180

# ── Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Vector DB (Qdrant) ───────────────────────────────────────────────────
# Set QDRANT_PATH for embedded mode (no server, local dev). Leave empty to use
# a Qdrant server at QDRANT_URL (docker-compose / production).
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
QDRANT_COLLECTION=documents

# ── Relational DB (Postgres in prod, SQLite for local test) ──────────────
# Local:  sqlite:///data/app.db
# Docker: postgresql+psycopg2://rag:rag@postgres:5432/rag
DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag
# Create tables on startup if missing (dev convenience). Use Alembic in prod.
AUTO_CREATE_TABLES=true

# ── Auth / tenancy ───────────────────────────────────────────────────────
# Header end users send their per-chatbot API key in.
API_KEY_HEADER=X-API-Key
# If set, /admin endpoints require this token via the X-Admin-Token header.
# Empty = admin endpoints are open (single-operator default). SET THIS IN PROD.
ADMIN_TOKEN=

# ── Rate limiting (per API key) ──────────────────────────────────────────
RATE_LIMIT=30/minute

# ── Retrieval / chunking ─────────────────────────────────────────────────
TOP_K=4
SCORE_THRESHOLD=0.30
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Conversation history ─────────────────────────────────────────────────
HISTORY_MAX_TURNS=6

# ── App ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
