# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
# DO NOT commit .env.prod.

# ── Domains (point both as A records to your VPS IP) ──────────────────────────
# Current live values (ambrosianuk.com, VPS 75.119.149.137):
#   API_DOMAIN=api.ambrosianuk.com
#   APP_DOMAIN=chat.ambrosianuk.com
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
ACME_EMAIL=you@yourdomain.com         # only used by the Caddy variant; host-nginx uses certbot

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rag

# ── Secrets (generate strong random values!) ─────────────────────────────────
# JWT_SECRET signs dashboard login tokens. ADMIN_TOKEN guards /admin/*.
# Generate each with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars
ADMIN_TOKEN=CHANGE_ME_64_hex_chars

# ── LLM ───────────────────────────────────────────────────────────────────────
# Option A — LOCAL Ollama on CPU (default). qwen2.5:1.5b is the CPU sweet spot.
#   docker compose -f docker-compose.vps.yml exec ollama ollama pull qwen2.5:1.5b
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b

# Option B — HOSTED API (fast, no CPU load). Set ONLY provider + key here; the
# MODEL is chosen per-chatbot in the dashboard (Config > Model). Free Groq key
# from console.groq.com.
#LLM_PROVIDER=groq
#LLM_API_KEY=gsk_...your-key-here
# (Same class also serves: gemini (AIza...), openai (sk-...), deepseek (sk-...).
#  Set the matching model name per-chatbot in the dashboard.)

# Retrieval tuning (applies to all providers).
LLM_NUM_CTX=2048
TOP_K=3
SCORE_THRESHOLD=0.30
# Memory: how many recent turns to include in the prompt. Higher = better
# memory but more tokens per message. Lower to save tokens on a free tier.
HISTORY_MAX_TURNS=6
