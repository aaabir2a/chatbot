# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
# DO NOT commit .env.prod.

# ── Domains (point both as A records to your VPS IP) ──────────────────────────
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
ACME_EMAIL=you@yourdomain.com         # for Let's Encrypt notifications

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rag

# ── Secrets (generate strong random values!) ─────────────────────────────────
# JWT_SECRET signs dashboard login tokens. ADMIN_TOKEN guards /admin/*.
# Generate each with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars
ADMIN_TOKEN=CHANGE_ME_64_hex_chars

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_MODEL=qwen2.5:3b
