# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.
# DO NOT commit .env.prod.

# ── Domains (point both as A records to your VPS IP) ──────────────────────────
# Current live values (ambrosianuk.com, VPS 75.119.149.137):
#   API_DOMAIN=api.ambrosianuk.com
#   APP_DOMAIN=chat.ambrosianuk.com
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
ACME_EMAIL=you@yourdomain.com         # only used by the Caddy variant; host-nginx uses certbot

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rag

# ── Secrets (generate strong random values!) ─────────────────────────────────
# JWT_SECRET signs dashboard login tokens. ADMIN_TOKEN guards /admin/*.
# Generate each with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars
ADMIN_TOKEN=CHANGE_ME_64_hex_chars

# ── LLM (tuned for speed on CPU) ──────────────────────────────────────────────
# Default model for NEW chatbots. qwen2.5:1.5b is the sweet spot on CPU:
# noticeably faster than 3b, still professional. (llama3.2:1b = fastest, weaker.)
# Pull it first:  docker compose -f docker-compose.vps.yml exec ollama ollama pull qwen2.5:1.5b
LLM_MODEL=qwen2.5:1.5b
# Smaller context window = less to process = faster on CPU.
LLM_NUM_CTX=2048
# Fewer retrieved chunks = shorter prompt = faster, still accurate for FAQs.
TOP_K=3
SCORE_THRESHOLD=0.30
