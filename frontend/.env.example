# Base URL of the FastAPI backend.
# --- LOCAL DEV (active) ---
VITE_API_URL=http://localhost:8000

# --- LIVE (ambrosianuk.com) ---
# In production this is NOT set here — it is baked into the frontend image at
# build time via docker-compose.vps.yml (build arg VITE_API_URL). Value used:
# VITE_API_URL=https://api.ambrosianuk.com
